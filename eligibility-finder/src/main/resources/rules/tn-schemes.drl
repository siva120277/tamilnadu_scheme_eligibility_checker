rule "20. TN Free Agricultural Electricity Scheme"
    when
        $c : CitizenProfile(occupation != null && occupation.equalsIgnoreCase("FARMER"))
    then
        $c.addEligibleScheme("TN_AGRI_01");
end

rule "21. Pradhan Mantri Vishwakarma Scheme"
    when
        $c : CitizenProfile(occupation != null && occupation.equalsIgnoreCase("SELF_EMPLOYED"), age >= 18)
    then
        $c.addEligibleScheme("PMV_01");
end

rule "22. Pradhan Mantri Ujjwala Yojana"
    when
        $c : CitizenProfile(gender != null && gender.equalsIgnoreCase("FEMALE"), age >= 18, annualIncome <= 150000)
    then
        $c.addEligibleScheme("PM_UJJWALA_01");
end

rule "23. Atal Pension Yojana"
    when
        $c : CitizenProfile(age >= 18 && age <= 40,
