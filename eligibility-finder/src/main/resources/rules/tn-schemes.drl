        $c.addEligibleScheme("TN_PSC_01");
end

rule "47. Stand-Up India Entrepreneurship Loan Scheme"
    when
        $c : CitizenProfile(age >= 18,
                            occupation != null && (occupation.equalsIgnoreCase("SELF_EMPLOYED") || occupation.equalsIgnoreCase("UNEMPLOYED")),
                            (gender != null && gender.equalsIgnoreCase("FEMALE")) ||
                            (community != null && (community.equalsIgnoreCase("SC") || community.equalsIgnoreCase("ST"))))
    then
        $c.addEligibleScheme("STANDUP_01");
end

rule "48. TAHDCO Entrepreneur Loan and Subsidy for SC ST"
    when
