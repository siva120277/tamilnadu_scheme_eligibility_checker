package rules;

import com.tn.schemes.eligibility_finder.model.CitizenProfile;

rule "1. Kalaignar Magalir Urimai Thogai"
    when
        $c : CitizenProfile(gender != null && gender.equalsIgnoreCase("FEMALE"), age >= 21, annualIncome < 250000)
    then
        $c.addEligibleScheme("KMUT_01");
end

rule "2. Pudhumai Penn Scheme"
    when
        $c : CitizenProfile(gender != null && gender.equalsIgnoreCase("FEMALE"), age >= 17 && age <= 25,
                            educationLevel != null && educationLevel.equalsIgnoreCase("HIGHER_EDUCATION"))
    then
        $c.addEligibleScheme("PP_01");
end

rule "3. Tamizh Pudhalvan Scheme"
    when
        $c : CitizenProfile(gender != null && gender.equalsIgnoreCase("MALE"), age >= 17 && age <= 25,
                            educationLevel != null && educationLevel.equalsIgnoreCase("HIGHER_EDUCATION"))
    then
        $c.addEligibleScheme("TP_01");
end

rule "4. Chief Minister Comprehensive Health Insurance Scheme"
    when
        $c : CitizenProfile(annualIncome <= 120000)
    then
        $c.addEligibleScheme("CMCHIS_01");
end

rule "5. Indira Gandhi National Old Age Pension"
    when
        $c : CitizenProfile(age >= 60, annualIncome <= 100000)
    then
        $c.addEligibleScheme("OAP_01");
end

rule "6. Destitute Widow Pension Scheme"
    when
        $c : CitizenProfile(gender != null && gender.equalsIgnoreCase("FEMALE"),
                            maritalStatus != null && maritalStatus.equalsIgnoreCase("WIDOW"),
                            age >= 18, annualIncome <= 100000)
    then
        $c.addEligibleScheme("WIDOW_01");
end

rule "7. Unmarried Poor Women Pension Scheme"
    when
        $c : CitizenProfile(gender != null && gender.equalsIgnoreCase("FEMALE"),
                            maritalStatus != null && maritalStatus.equalsIgnoreCase("UNMARRIED"),
                            age >= 50, annualIncome <= 100000)
    then
        $c.addEligibleScheme("UNMARRIED_01");
end

rule "8. PM-KISAN Samman Nidhi"
    when
        $c : CitizenProfile(occupation != null && occupation.equalsIgnoreCase("FARMER"), annualIncome <= 200000)
    then
        $c.addEligibleScheme("PMKISAN_01");
end

rule "9. TN Micro Irrigation Subsidy"
    when
        $c : CitizenProfile(occupation != null && occupation.equalsIgnoreCase("FARMER"), annualIncome <= 500000)
    then
        $c.addEligibleScheme("TN_IRR_01");
end

rule "10. Kalaignar Kanavu Illam Housing Scheme"
    when
        $c : CitizenProfile(age >= 21, annualIncome <= 150000)
    then
        $c.addEligibleScheme("KKI_01");
end

rule "11. Pradhan Mantri Awas Yojana"
    when
        $c : CitizenProfile(age >= 21, annualIncome <= 300000)
    then
        $c.addEligibleScheme("PMAY_01");
end

rule "12. Ayushman Bharat PM-JAY"
    when
        $c : CitizenProfile(annualIncome <= 150000)
    then
        $c.addEligibleScheme("PMJAY_01");
end

rule "13. TN BC MBC DNC Post-Matric Scholarship"
    when
        $c : CitizenProfile(community != null && (community.equalsIgnoreCase("BC") || community.equalsIgnoreCase("MBC") || community.equalsIgnoreCase("DNC")),
                            educationLevel != null && educationLevel.equalsIgnoreCase("HIGHER_EDUCATION"),
                            annualIncome <= 250000)
    then
        $c.addEligibleScheme("BC_SCHOL_01");
end

rule "14. Post-Matric Scholarship for SC ST Students"
    when
        $c : CitizenProfile(community != null && (community.equalsIgnoreCase("SC") || community.equalsIgnoreCase("ST")),
                            educationLevel != null && educationLevel.equalsIgnoreCase("HIGHER_EDUCATION"),
                            annualIncome <= 250000)
    then
        $c.addEligibleScheme("SC_SCHOL_01");
end

rule "15. Pradhan Mantri Mudra Yojana"
    when
        $c : CitizenProfile(age >= 18 && age <= 65,
                            occupation != null && (occupation.equalsIgnoreCase("SELF_EMPLOYED") || occupation.equalsIgnoreCase("UNEMPLOYED")))
    then
        $c.addEligibleScheme("PMMY_01");
end

rule "16. Vidiyal Payanam Free Bus Travel for Women"
    when
        $c : CitizenProfile(gender != null && gender.equalsIgnoreCase("FEMALE"), age >= 5)
