rule "24. Pradhan Mantri Suraksha Bima Yojana"
    when
        $c : CitizenProfile(age >= 18 && age <= 70)
    then
        $c.addEligibleScheme("PMSBY_01");
end

rule "25. Pradhan Mantri Jeevan Jyoti Bima Yojana"
